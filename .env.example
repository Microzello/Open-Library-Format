APP_SECRET=CHANGE_ME_$(Get-Random -Maximum 999999)
LIBRARIES_ROOT=/data/libraries
UPLOAD_MAX_MB=512
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080
WORKERS=1
BOOTSTRAP_MODE=wizard
BOOTSTRAP_TOKEN=
ADMIN_USERNAME=
ADMIN_PASSWORD_BCRYPT=
ALLOW_SIGNUP=false
DEFAULT_TZ=UTC
ENABLE_FFMPEG=auto
ENABLE_EXIFTOOL=auto
ALLOW_PURGE=false
CONTENT_SECURITY_POLICY=default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com 'unsafe-inline'
